# Vite reads VITE_* variables at build time. Copy to .env to enable ads.
# Google AdSense publisher id (leave empty for an ad-free build).
VITE_ADSENSE_CLIENT=
# Ad-unit ids for the placements in the editor.
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_LIBRARY=
# API origin when the web app is not served by the API itself.
# VITE_API_URL=https://api.example.com
