// Prisma 7 with the pg driver adapter (see src/prisma/prisma.service.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Template {
  id             String                       @id
  name           String
  kind           String                       @default("user")
  prompt         String?
  /// Compact DSL when the template came from the AI or a DSL starter.
  dsl            String?
  root           Json
  screenshot     Bytes?
  screenshotType String?                      @map("screenshot_type")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  @@index([kind])
  @@map("templates")
}

model Generation {
  id             String                       @id
  conversationId String?                      @map("conversation_id")
  prompt         String
  options   Json
  dsl       String
  root      Json
  engine    String
  rating    Int                          @default(0)
  createdAt DateTime                     @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([conversationId])
  @@map("generations")
}

/// A chat thread with the assistant (ChatGPT-style history).
model Conversation {
  id        String    @id
  title     String    @default("New chat")
  /// The brief, current DSL and applied instructions the next edit starts from.
  context   Json?
  messages  Message[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String       @map("conversation_id")
  role           String
  text           String
  /// Generation attached to an assistant reply (template draft or refinement).
  generationId   String?      @map("generation_id")
  /// Subject-line ideas, library search hits, applied instructions: small JSON payloads.
  payload        Json?
  error          Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}
