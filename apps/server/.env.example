# Copy to .env (loaded by @nestjs/config). All values optional.
PORT=8787
# PostgreSQL with pgvector (docker compose up -d postgres at the repo root).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Generation: Gemini API key from https://aistudio.google.com/apikey. Without
# it the server writes templates with its built-in rules engine.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.8-flash
AI_TIMEOUT_MS=60000

# Embeddings for pgvector (library search, similar templates, examples for
# Gemini). Default: local Ollama. `ollama pull nomic-embed-text` once.
EMBEDDINGS_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
# EMBEDDINGS_PROVIDER=gemini uses GEMINI_EMBEDDING_MODEL (768-d output) instead.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Comma-separated origins allowed by CORS (default: any).
# CORS_ORIGIN=https://builder.example.com
# Built web app to serve (default ../web/dist).
# WEB_DIST=../web/dist
