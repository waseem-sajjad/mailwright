# Copy to .env (loaded by @nestjs/config). All values optional.
PORT=8787
# PostgreSQL (docker compose up -d postgres at the repo root).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Gemini API key from https://aistudio.google.com/apikey. Without it the
# server writes templates with its built-in rules engine.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.8-flash
AI_TIMEOUT_MS=60000

# Set to true when behind a reverse proxy so rate limits see real client IPs.
TRUST_PROXY=false
# Comma-separated origins allowed by CORS (default: any).
# CORS_ORIGIN=https://builder.example.com
# Built web app to serve (default ../web/dist).
# WEB_DIST=../web/dist
