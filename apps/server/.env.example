# Copy to .env (loaded automatically). All values optional.
PORT=8787
# Gemini API key from https://aistudio.google.com/apikey. Without it the
# server generates with its built-in rules engine.
GEMINI_API_KEY=
# Gemini model id (default models/gemini-3.8-flash).
GEMINI_MODEL=models/gemini-3.8-flash
# Request timeout for Gemini calls.
AI_TIMEOUT_MS=60000
# Where SQLite and screenshots live.
DATA_DIR=data
# Comma-separated origins allowed by CORS (default: any).
# CORS_ORIGIN=https://builder.example.com
